# MPAQT Release Credentials
# =========================
# Copy this file to: release-credentials.yml
#
# How to get tokens:
# - GitHub: Settings > Developer settings > Personal access tokens
# - Docker: hub.docker.com > Account Settings > Security > Access Tokens
# - Sylabs: cloud.sylabs.io > Access Tokens
# - Conda: anaconda.org > Settings > Access

github:
  username: your-github-username
  token: ghp_xxxxxxxxxxxxxxxxxxxx

docker:
  username: your-dockerhub-username
  password: dckr_pat_xxxxxxxxxxxx

sylabs:
  username: your-sylabs-username
  token: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

conda:
  username: your-anaconda-username
  token: an-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
