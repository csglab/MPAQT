Bootstrap: docker
From: continuumio/miniconda3:latest

%labels
    Author Ali Saberi, Michael Apostolides, Jichen Wang, Hamed S. Najafabadi
    Version 2.4.0
    Variant full
    Description MPAQT Full - with all optional dependencies (minimap2, samtools, Bioconductor packages)
    org.opencontainers.image.source https://github.com/csglab/MPAQT

%files
    environment.yml /opt/environment.yml
    mpaqt-source /opt/mpaqt-source

%environment
    export PATH=/opt/conda/envs/mpaqt-full/bin:$PATH
    export LC_ALL=C
    export CONDA_DEFAULT_ENV=mpaqt-full

%post
    # Use the solver bundled with the base image. Installing standalone mamba
    # here can upgrade libmamba and break resolution of older Bioconda builds.
    /opt/conda/bin/conda env create --solver libmamba -f /opt/environment.yml

    # Install mpaqt R package
    /opt/conda/envs/mpaqt-full/bin/R CMD INSTALL /opt/mpaqt-source

    # CLI exposure is intentionally disabled; use the R API.
    # cp /opt/mpaqt-source/inst/bin/mpaqt /opt/conda/envs/mpaqt-full/bin/mpaqt
    # chmod +x /opt/conda/envs/mpaqt-full/bin/mpaqt

    # Clean up to reduce image size
    /opt/conda/bin/conda clean --all -y
    rm -rf /opt/conda/pkgs/*
    rm -rf /root/.cache/*
    rm -rf /opt/mpaqt-source
    rm -f /opt/environment.yml

    # Create working directory
    mkdir -p /data

%runscript
    exec "$@"

%test
    echo "Testing MPAQT Full container..."
    R --version | head -1
    kallisto version
    bustools version
    minimap2 --version
    samtools --version | head -1
    R --slave -e 'library(mpaqt); stopifnot(as.character(packageVersion("mpaqt")) == "2.4.0"); cat("MPAQT 2.4.0 OK\n")'
    R --slave -e 'library(bambu); cat("bambu available\n")'
    # CLI smoke test disabled; the release exposes only the R API.
    # mpaqt --help | head -5
    test ! -e /opt/conda/envs/mpaqt-full/bin/mpaqt
    echo "All tests passed!"

%help
    MPAQT Full - Multi-Platform Accurate Quantification of Transcripts

    This image includes all optional dependencies:
      - minimap2, samtools (for long-read alignment)
      - bambu, BiocFileCache, SummarizedExperiment (for FLNC processing)
      - Biostrings, rtracklayer, GenomicRanges (for transcriptome extraction)

    Usage:
      apptainer run mpaqt-full.sif R
      apptainer exec mpaqt-full.sif Rscript your_script.R
      apptainer exec mpaqt-full.sif Rscript -e 'library(mpaqt)'

    This release exposes the supported R API. See the documentation for
    indexing, data preparation, and quantification examples.

    Authors: Ali Saberi, Michael Apostolides, Jichen Wang, Hamed S. Najafabadi
    Documentation: https://csglab.github.io/MPAQT/
