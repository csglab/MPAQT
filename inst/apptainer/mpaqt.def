Bootstrap: docker
From: continuumio/miniconda3:latest

%labels
    Author Ali Saberi, Michael Apostolides, Jichen Wang, Hamed S. Najafabadi
    Version 2.4.0
    Variant stable
    Description MPAQT - Multi-Platform Accurate Quantification of Transcripts
    org.opencontainers.image.source https://github.com/csglab/MPAQT_merged

%files
    environment.yml /opt/environment.yml
    mpaqt-source /opt/mpaqt-source

%environment
    export PATH=/opt/conda/envs/mpaqt/bin:$PATH
    export LC_ALL=C
    export CONDA_DEFAULT_ENV=mpaqt

%post
    # Use the solver bundled with the base image. Installing standalone mamba
    # here can upgrade libmamba and break resolution of older Bioconda builds.
    /opt/conda/bin/conda env create --solver libmamba -f /opt/environment.yml

    # Install mpaqt R package
    /opt/conda/envs/mpaqt/bin/R CMD INSTALL /opt/mpaqt-source

    # CLI exposure is intentionally disabled; use the R API.
    # cp /opt/mpaqt-source/inst/bin/mpaqt /opt/conda/envs/mpaqt/bin/mpaqt
    # chmod +x /opt/conda/envs/mpaqt/bin/mpaqt

    # Clean up to reduce image size
    /opt/conda/bin/conda clean --all -y
    rm -rf /opt/conda/pkgs/*
    rm -rf /root/.cache/*
    rm -rf /opt/mpaqt-source
    rm -f /opt/environment.yml

    # Create working directory
    mkdir -p /data

%runscript
    exec "$@"

%test
    echo "Testing MPAQT container..."
    R --version | head -1
    kallisto version
    bustools version
    R --slave -e 'library(mpaqt); stopifnot(as.character(packageVersion("mpaqt")) == "2.4.0"); cat("MPAQT 2.4.0 OK\n")'
    # CLI smoke test disabled; the release exposes only the R API.
    # mpaqt --help | head -5
    test ! -e /opt/conda/envs/mpaqt/bin/mpaqt
    echo "All tests passed!"

%help
    MPAQT - Multi-Platform Accurate Quantification of Transcripts

    Usage:
      apptainer run mpaqt.sif R
      apptainer exec mpaqt.sif Rscript your_script.R
      apptainer exec mpaqt.sif Rscript -e 'library(mpaqt)'

    This release exposes the supported R API. See the documentation for
    indexing, data preparation, and quantification examples.

    Authors: Ali Saberi, Michael Apostolides, Jichen Wang, Hamed S. Najafabadi
    Documentation: https://csglab.github.io/mpaqt2/
