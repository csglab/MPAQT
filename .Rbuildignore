# Development files
^VERSION$
^release_.*\.sh$
^release_common\.sh$

^log\.txt$
^release_log\.txt$
^release_cred\.yml$
^release_cred\.yml\.template$

# R package development
^\.Rproj\.user$
^.*\.Rproj$
^LICENSE\.md$

# CI/CD
^\.github$

# Documentation
^docs$
^pkgdown$
^_pkgdown\.yml$

# Other
^\.gitignore$

# Release artifacts
^releases$

# Container build files (not needed in R package)
^inst/docker$
^inst/apptainer$
^inst/conda-recipe$

# Migration metadata
^MIGRATION\.md$
^migration-manifest\.json$
